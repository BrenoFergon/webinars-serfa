<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Webinars — ForTraffic SERFA</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: #2e3348;
      --text: #e2e8f0;
      --muted: #8892a4;
      --accent: #6366f1;
      --accent2: #818cf8;
      --hot: #f97316;
      --cold: #38bdf8;
      --ideal: #22c55e;
      --bom: #facc15;
      --descarte: #f87171;
      --radius: 10px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 14px;
      line-height: 1.6;
    }

    /* ── HEADER ── */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .logo { font-size: 16px; font-weight: 700; color: var(--text); letter-spacing: -.3px; }
    .logo span { color: var(--accent2); }
    .meta-info { font-size: 12px; color: var(--muted); text-align: right; }
    .meta-info strong { color: var(--text); }

    /* ── LAYOUT ── */
    main { max-width: 1280px; margin: 0 auto; padding: 24px 20px; }

    .section-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      margin-bottom: 12px;
    }

    /* ── FUNIL GLOBAL ── */
    .funnel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      margin-bottom: 32px;
    }
    .funnel-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
    }
    .funnel-card .label { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
    .funnel-card .value { font-size: 22px; font-weight: 700; color: var(--text); }
    .funnel-card .sub { font-size: 11px; color: var(--muted); margin-top: 2px; }

    /* ── TABS ── */
    .tabs {
      display: flex;
      gap: 4px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 24px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }
    .tab-btn {
      background: none;
      border: none;
      color: var(--muted);
      padding: 10px 16px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
      transition: color .15s, border-color .15s;
    }
    .tab-btn:hover { color: var(--text); }
    .tab-btn.active { color: var(--accent2); border-bottom-color: var(--accent2); }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* ── WEBINAR TOP ROW ── */
    .webinar-top {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }
    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
    }
    .kpi-card .label { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
    .kpi-card .value { font-size: 26px; font-weight: 700; }
    .kpi-card.invest .value { color: #a78bfa; }
    .kpi-card.cpl    .value { color: #34d399; }
    .kpi-card.leads  .value { color: var(--accent2); }

    /* ── TWO-COL ── */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }
    @media (max-width: 700px) { .two-col { grid-template-columns: 1fr; } }

    /* ── AUDIENCE CARDS ── */
    .audience-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .audience-card {
      background: var(--surface2);
      border-radius: var(--radius);
      padding: 14px 16px;
      border-left: 3px solid;
    }
    .audience-card.hot { border-color: var(--hot); }
    .audience-card.cold { border-color: var(--cold); }
    .audience-card .tag {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      margin-bottom: 8px;
    }
    .audience-card.hot .tag { color: var(--hot); }
    .audience-card.cold .tag { color: var(--cold); }
    .audience-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .audience-row .k { color: var(--muted); font-size: 12px; }
    .audience-row .v { font-weight: 600; font-size: 13px; }

    /* ── CARD WRAPPER ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
    }
    .card-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .06em;
      margin-bottom: 14px;
    }

    /* ── ATTENDANCE ── */
    .attendance-bars { display: flex; flex-direction: column; gap: 10px; }
    .att-item { }
    .att-header { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .att-label { font-size: 12px; color: var(--muted); }
    .att-val { font-size: 12px; font-weight: 600; }
    .bar-track {
      height: 6px;
      background: var(--surface2);
      border-radius: 3px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      border-radius: 3px;
      transition: width .4s ease;
    }
    .bar-live   { background: #818cf8; }
    .bar-replay { background: #38bdf8; }
    .bar-oferta { background: #22c55e; }

    /* ── CHANNELS ── */
    .channel-list { display: flex; flex-direction: column; gap: 8px; }
    .channel-row { display: flex; align-items: center; gap: 10px; }
    .channel-name { font-size: 12px; color: var(--muted); width: 130px; flex-shrink: 0; }
    .channel-bar-wrap { flex: 1; height: 6px; background: var(--surface2); border-radius: 3px; overflow: hidden; }
    .channel-bar-fill { height: 100%; border-radius: 3px; background: var(--accent); }
    .channel-count { font-size: 12px; font-weight: 600; width: 36px; text-align: right; }
    .channel-pct { font-size: 11px; color: var(--muted); width: 36px; text-align: right; }

    /* ── SCORING ── */
    .scoring-totals {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
    }
    .score-pill {
      flex: 1;
      text-align: center;
      padding: 10px 8px;
      border-radius: 8px;
      background: var(--surface2);
    }
    .score-pill .n { font-size: 22px; font-weight: 700; }
    .score-pill .l { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-top: 2px; }
    .score-pill.ideal .n { color: var(--ideal); }
    .score-pill.bom   .n { color: var(--bom); }
    .score-pill.desc  .n { color: var(--descarte); }

    .scoring-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .scoring-table th {
      text-align: left;
      color: var(--muted);
      font-weight: 500;
      padding: 4px 6px 8px;
      border-bottom: 1px solid var(--border);
    }
    .scoring-table td { padding: 6px 6px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .scoring-table tr:last-child td { border-bottom: none; }
    .tipo-badge {
      display: inline-block;
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .04em;
    }
    .tipo-badge.hot  { background: rgba(249,115,22,.15); color: var(--hot); }
    .tipo-badge.cold { background: rgba(56,189,248,.15); color: var(--cold); }
    .score-num { font-weight: 700; }
    .score-num.ideal   { color: var(--ideal); }
    .score-num.bom     { color: var(--bom); }
    .score-num.descarte { color: var(--descarte); }

    /* ── CHART ── */
    .chart-wrap { position: relative; height: 160px; }

    /* ── BOTTOM ROW ── */
    .bottom-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
      margin-top: 16px;
    }
    @media (max-width: 900px) { .bottom-row { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .bottom-row { grid-template-columns: 1fr; } }

    /* ── CRIATIVOS ── */
    .criativo-list { display: flex; flex-direction: column; gap: 8px; }
    .criativo-row { display: flex; align-items: center; gap: 10px; }
    .criativo-name {
      font-size: 11px;
      color: var(--muted);
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .criativo-bar-wrap { width: 80px; height: 6px; background: var(--surface2); border-radius: 3px; overflow: hidden; }
    .criativo-bar-fill { height: 100%; border-radius: 3px; background: #a78bfa; }
    .criativo-spend { font-size: 12px; font-weight: 600; width: 58px; text-align: right; }

    /* ── LEITURA ── */
    .leitura-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 24px;
    }
    @media (max-width: 700px) { .leitura-grid { grid-template-columns: 1fr; } }
    .leitura-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 20px;
    }
    .leitura-card .lang-tag {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      background: var(--surface2);
      color: var(--accent2);
      padding: 2px 8px;
      border-radius: 4px;
      margin-bottom: 10px;
    }
    .leitura-card p { font-size: 13px; color: var(--text); line-height: 1.7; }

    /* ── GLOBAL CHARTS ROW ── */
    .global-charts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 24px;
      margin-bottom: 8px;
    }
    @media (max-width: 700px) { .global-charts { grid-template-columns: 1fr; } }
    .chart-wrap-sm { position: relative; height: 180px; }

    /* ── DIVIDER ── */
    .divider { height: 1px; background: var(--border); margin: 28px 0; }

    /* ── LOADING ── */
    #loading {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 300px;
      color: var(--muted);
      font-size: 14px;
    }
  </style>
</head>
<body>

<header>
  <div class="logo">ForTraffic <span>SERFA</span> — Webinars Evergreen</div>
  <div class="meta-info" id="header-meta">Carregando…</div>
</header>

<main>
  <div id="loading">Carregando dados…</div>
  <div id="dashboard" style="display:none">

    <!-- FUNIL GLOBAL -->
    <p class="section-title">Funil Global</p>
    <div class="funnel-grid" id="funnel-grid"></div>

    <!-- SEGMENTAÇÃO + CRIATIVOS -->
    <p class="section-title">Segmentação & Criativos</p>
    <div class="global-charts">
      <div class="card">
        <div class="card-title">Gasto por Gênero</div>
        <div class="chart-wrap-sm"><canvas id="chart-genero"></canvas></div>
      </div>
      <div class="card">
        <div class="card-title">Gasto por Faixa Etária</div>
        <div class="chart-wrap-sm"><canvas id="chart-faixa"></canvas></div>
      </div>
    </div>

    <div class="card" style="margin-top:16px; margin-bottom:32px;">
      <div class="card-title">Top Criativos por Gasto</div>
      <div class="criativo-list" id="criativos-list"></div>
    </div>

    <div class="divider"></div>

    <!-- WEBINARIOS TABS -->
    <p class="section-title">Webinários</p>
    <div class="tabs" id="tabs"></div>
    <div id="tab-panels"></div>

    <!-- LEITURA -->
    <div class="divider"></div>
    <p class="section-title">Leitura dos Dados</p>
    <div class="leitura-grid" id="leitura-grid"></div>

  </div>
</main>

<script>
const EUR = v => `€ ${parseFloat(v).toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2})}`;
const NUM = v => parseInt(v).toLocaleString('pt-BR');
const PCT = v => `${parseFloat(v).toFixed(1)}%`;

const COLORS = ['#6366f1','#38bdf8','#f97316','#22c55e','#facc15','#f87171','#a78bfa','#34d399'];

function buildFunnel(g) {
  const items = [
    { label: 'Investimento', value: EUR(g.investimento_total), sub: '' },
    { label: 'Impressões', value: NUM(g.impressoes), sub: '' },
    { label: 'Cliques', value: NUM(g.cliques), sub: `CTR ${PCT(g.ctr)}` },
    { label: 'Page Views', value: NUM(g.page_views), sub: `Connect ${PCT(g.connect_rate)}` },
  ];
  const el = document.getElementById('funnel-grid');
  el.innerHTML = items.map(i => `
    <div class="funnel-card">
      <div class="label">${i.label}</div>
      <div class="value">${i.value}</div>
      ${i.sub ? `<div class="sub">${i.sub}</div>` : ''}
    </div>`).join('');
}

function buildCriativos(list) {
  const max = list[0]?.spend || 1;
  document.getElementById('criativos-list').innerHTML = list.map(c => `
    <div class="criativo-row">
      <div class="criativo-name" title="${c.nome}">${c.nome}</div>
      <div class="criativo-bar-wrap"><div class="criativo-bar-fill" style="width:${c.spend/max*100}%"></div></div>
      <div class="criativo-spend">${EUR(c.spend)}</div>
    </div>`).join('');
}

function buildGeneroChart(data) {
  const labels = data.map(d => d.grupo === 'female' ? 'Feminino' : d.grupo === 'male' ? 'Masculino' : d.grupo);
  new Chart(document.getElementById('chart-genero'), {
    type: 'doughnut',
    data: { labels, datasets: [{ data: data.map(d => d.spend), backgroundColor: ['#818cf8','#38bdf8','#f97316'], borderWidth: 0 }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', labels: { color: '#8892a4', font: { size: 11 }, padding: 12 } },
        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${EUR(ctx.raw)}` } }
      }
    }
  });
}

function buildFaixaChart(data) {
  new Chart(document.getElementById('chart-faixa'), {
    type: 'bar',
    data: {
      labels: data.map(d => d.grupo),
      datasets: [{ data: data.map(d => d.spend), backgroundColor: '#6366f1', borderRadius: 4, borderSkipped: false }]
    },
    options: {
      responsive: true, maintainAspectRatio: false, indexAxis: 'y',
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${EUR(ctx.raw)}` } } },
      scales: {
        x: { grid: { color: '#2e3348' }, ticks: { color: '#8892a4', font: { size: 10 }, callback: v => EUR(v) } },
        y: { grid: { display: false }, ticks: { color: '#8892a4', font: { size: 11 } } }
      }
    }
  });
}

function buildWebinar(w, idx) {
  const sc = w.lead_scoring;
  const scTotal = sc.totais.Ideal + sc.totais.Bom + sc.totais.Descarte;

  const canaisHTML = w.canais.map(c => `
    <div class="channel-row">
      <div class="channel-name">${c.canal}</div>
      <div class="channel-bar-wrap"><div class="channel-bar-fill" style="width:${c.pct}%"></div></div>
      <div class="channel-count">${c.leads}</div>
      <div class="channel-pct">${PCT(c.pct)}</div>
    </div>`).join('');

  const scoringRows = sc.grupos.slice(0, 6).map(g => `
    <tr>
      <td><span class="tipo-badge ${g.tipo.toLowerCase()}">${g.tipo}</span></td>
      <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${g.criativo}">${g.criativo}</td>
      <td class="score-num ideal">${g.ideal}</td>
      <td class="score-num bom">${g.bom}</td>
      <td class="score-num descarte">${g.descarte}</td>
    </tr>`).join('');

  const panel = document.createElement('div');
  panel.className = 'tab-panel';
  panel.id = `panel-${idx}`;
  panel.innerHTML = `
    <div class="webinar-top">
      <div class="kpi-card invest">
        <div class="label">Investimento</div>
        <div class="value">${EUR(w.kpis.investimento_total)}</div>
      </div>
      <div class="kpi-card cpl">
        <div class="label">CPL</div>
        <div class="value">${EUR(w.kpis.cpl_total)}</div>
      </div>
      <div class="kpi-card leads">
        <div class="label">Leads Pagos</div>
        <div class="value">${NUM(w.kpis.leads_total)}</div>
      </div>
    </div>

    <div class="two-col">
      <div class="card">
        <div class="card-title">HOT vs COLD</div>
        <div class="audience-grid">
          <div class="audience-card hot">
            <div class="tag">HOT</div>
            <div class="audience-row"><span class="k">Gasto</span><span class="v">${EUR(w.audiencias.hot.spend)}</span></div>
            <div class="audience-row"><span class="k">Leads</span><span class="v">${w.audiencias.hot.leads}</span></div>
            <div class="audience-row"><span class="k">CPL</span><span class="v">${EUR(w.audiencias.hot.cpl)}</span></div>
          </div>
          <div class="audience-card cold">
            <div class="tag">COLD</div>
            <div class="audience-row"><span class="k">Gasto</span><span class="v">${EUR(w.audiencias.cold.spend)}</span></div>
            <div class="audience-row"><span class="k">Leads</span><span class="v">${w.audiencias.cold.leads}</span></div>
            <div class="audience-row"><span class="k">CPL</span><span class="v">${EUR(w.audiencias.cold.cpl)}</span></div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">Presença no Webinário</div>
        <div class="attendance-bars">
          <div class="att-item">
            <div class="att-header">
              <span class="att-label">Ao Vivo</span>
              <span class="att-val">${w.presenca.comparecimento_live} <span style="color:var(--muted);font-weight:400">(${PCT(w.presenca.pct_live)})</span></span>
            </div>
            <div class="bar-track"><div class="bar-fill bar-live" style="width:${w.presenca.pct_live}%"></div></div>
          </div>
          <div class="att-item">
            <div class="att-header">
              <span class="att-label">Replay</span>
              <span class="att-val">${w.presenca.comparecimento_replay} <span style="color:var(--muted);font-weight:400">(${PCT(w.presenca.pct_replay)})</span></span>
            </div>
            <div class="bar-track"><div class="bar-fill bar-replay" style="width:${w.presenca.pct_replay}%"></div></div>
          </div>
          <div class="att-item">
            <div class="att-header">
              <span class="att-label">Viu Oferta</span>
              <span class="att-val">${w.presenca.viu_oferta} <span style="color:var(--muted);font-weight:400">(${PCT(w.presenca.pct_oferta)})</span></span>
            </div>
            <div class="bar-track"><div class="bar-fill bar-oferta" style="width:${w.presenca.pct_oferta}%"></div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="two-col">
      <div class="card">
        <div class="card-title">Leads por Canal</div>
        <div class="channel-list">${canaisHTML}</div>
      </div>
      <div class="card">
        <div class="card-title">Leads por Dia</div>
        <div class="chart-wrap"><canvas id="chart-dia-${idx}"></canvas></div>
      </div>
    </div>

    <div class="card" style="margin-top:16px">
      <div class="card-title">Lead Scoring</div>
      <div class="scoring-totals">
        <div class="score-pill ideal"><div class="n">${sc.totais.Ideal}</div><div class="l">Ideal</div></div>
        <div class="score-pill bom"><div class="n">${sc.totais.Bom}</div><div class="l">Bom</div></div>
        <div class="score-pill desc"><div class="n">${sc.totais.Descarte}</div><div class="l">Descarte</div></div>
      </div>
      <table class="scoring-table">
        <thead><tr><th>Tipo</th><th>Criativo</th><th style="color:var(--ideal)">I</th><th style="color:var(--bom)">B</th><th style="color:var(--descarte)">D</th></tr></thead>
        <tbody>${scoringRows}</tbody>
      </table>
    </div>
  `;
  document.getElementById('tab-panels').appendChild(panel);

  // leads por dia chart
  requestAnimationFrame(() => {
    const ctx = document.getElementById(`chart-dia-${idx}`);
    if (!ctx) return;
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: w.leads_por_dia.map(d => d.data),
        datasets: [{ data: w.leads_por_dia.map(d => d.leads), backgroundColor: '#6366f1', borderRadius: 3, borderSkipped: false }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.raw} leads` } } },
        scales: {
          x: { grid: { display: false }, ticks: { color: '#8892a4', font: { size: 9 }, maxRotation: 45 } },
          y: { grid: { color: '#2e3348' }, ticks: { color: '#8892a4', font: { size: 10 } } }
        }
      }
    });
  });
}

function buildTabs(webinarios) {
  const tabsEl = document.getElementById('tabs');
  const SHORT = { 'EVERGREEN FORTRAFFIC ING LATAM': 'ING LATAM', 'EVERGREEN FORTRAFFIC ING ESPAÑA': 'ING ESPAÑA', 'EVERGREEN FORTRAFFIC ARQ ESPAÑA': 'ARQ ESPAÑA' };
  webinarios.forEach((w, i) => {
    const btn = document.createElement('button');
    btn.className = 'tab-btn' + (i === 0 ? ' active' : '');
    btn.textContent = SHORT[w.webinario] || w.webinario;
    btn.dataset.idx = i;
    btn.onclick = () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(`panel-${i}`).classList.add('active');
    };
    tabsEl.appendChild(btn);
  });
  const firstPanel = document.getElementById('panel-0');
  if (firstPanel) firstPanel.classList.add('active');
}

function buildLeitura(l) {
  document.getElementById('leitura-grid').innerHTML = `
    <div class="leitura-card">
      <div class="lang-tag">ES</div>
      <p>${l.es}</p>
    </div>
    <div class="leitura-card">
      <div class="lang-tag">PT</div>
      <p>${l.pt}</p>
    </div>`;
}

async function init() {
  try {
    const res = await fetch('data.json?t=' + Date.now());
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const d = await res.json();

    document.getElementById('header-meta').innerHTML =
      `<strong>${d.meta.cliente}</strong> &nbsp;·&nbsp; ${d.meta.periodo} &nbsp;·&nbsp; Atualizado ${d.meta.atualizado_em}`;

    buildFunnel(d.funil_global);
    buildCriativos(d.criativos);
    buildGeneroChart(d.segmentacao.genero);
    buildFaixaChart(d.segmentacao.faixa_etaria);
    d.webinarios.forEach((w, i) => buildWebinar(w, i));
    buildTabs(d.webinarios);
    buildLeitura(d.leitura);

    document.getElementById('loading').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
  } catch (e) {
    document.getElementById('loading').textContent = 'Erro ao carregar data.json: ' + e.message;
  }
}

init();
</script>
